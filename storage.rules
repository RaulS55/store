rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMember(companyId) {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/companies/$(companyId)/members/$(request.auth.uid)
        );
    }

    function isOwnerOrAdmin(companyId) {
      return request.auth != null
        && firestore.get(
          /databases/(default)/documents/companies/$(companyId)/members/$(request.auth.uid)
        ).data.role in ['owner', 'administrator'];
    }

    match /companies/{companyId}/products/{productId}/{fileName} {
      // Image.network loads download URLs without Firebase Auth.
      allow get: if true;
      allow list: if isMember(companyId);
      allow create: if isMember(companyId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow update, delete: if isOwnerOrAdmin(companyId);
    }
  }
}
