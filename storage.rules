rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMember(companyId) {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/companies/$(companyId)/members/$(request.auth.uid)
        );
    }

    match /companies/{companyId}/products/{productId}/{fileName} {
      allow read: if isMember(companyId);
      allow create: if isMember(companyId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow update, delete: if isMember(companyId);
    }
  }
}
