rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function memberPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid);
    }

    function memberDoc(companyId, uid) {
      return /databases/$(database)/documents/companies/$(companyId)/members/$(uid);
    }

    function companyDoc(companyId) {
      return /databases/$(database)/documents/companies/$(companyId);
    }

    function isMember(companyId) {
      return signedIn() && exists(memberPath(companyId));
    }

    function isOwner(companyId) {
      return isMember(companyId)
        && get(memberPath(companyId)).data.role == 'owner';
    }

    function isOwnerOrAdmin(companyId) {
      return isMember(companyId)
        && get(memberPath(companyId)).data.role in ['owner', 'administrator'];
    }

    function hasSyncFields(id) {
      return request.resource.data.keys().hasAll([
          'id',
          'createdAt',
          'updatedAt',
          'deletedAt',
        ])
        && request.resource.data.id == id
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && (
          request.resource.data.deletedAt == null
          || request.resource.data.deletedAt is string
        );
    }

    function invitationPath(companyId, invitationId) {
      return /databases/$(database)/documents/companies/$(companyId)/invitations/$(invitationId);
    }

    function pendingInviteForEmail(companyId, invitationId) {
      return exists(invitationPath(companyId, invitationId))
        && get(invitationPath(companyId, invitationId)).data.status == 'pending'
        && get(invitationPath(companyId, invitationId)).data.email == email();
    }

    function isJoiningOwnedCompany(companyId) {
      return existsAfter(memberPath(companyId))
        && getAfter(memberPath(companyId)).data.email == email()
        && getAfter(memberPath(companyId)).data.role == 'owner'
        && getAfter(companyDoc(companyId)).data.ownerId == request.auth.uid;
    }

    function isJoiningViaInvite(companyId) {
      return existsAfter(memberPath(companyId))
        && getAfter(memberPath(companyId)).data.email == email()
        && getAfter(memberPath(companyId)).data.role in ['employee', 'administrator']
        && getAfter(memberPath(companyId)).data.invitationId is string;
    }

    function canOwnerClearCompany(uid) {
      return signedIn()
        && resource.data.companyId is string
        && resource.data.companyId.size() > 0
        && isOwner(resource.data.companyId)
        && exists(memberDoc(resource.data.companyId, uid))
        && get(memberDoc(resource.data.companyId, uid)).data.role in ['employee', 'administrator']
        && request.resource.data.companyId == ''
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName;
    }

    function canSelfClearOrphanCompany(uid) {
      return isSelf(uid)
        && resource.data.companyId is string
        && resource.data.companyId.size() > 0
        && !exists(memberDoc(resource.data.companyId, uid))
        && request.resource.data.companyId == ''
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.email == email()
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && request.resource.data.displayName is string;
      allow update: if (
        isSelf(uid)
        && request.resource.data.email == resource.data.email
        && request.resource.data.companyId == resource.data.companyId
      ) || (
        isSelf(uid)
        && request.resource.data.email == resource.data.email
        && resource.data.companyId == ''
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() > 0
        && (
          isJoiningOwnedCompany(request.resource.data.companyId)
          || isJoiningViaInvite(request.resource.data.companyId)
        )
      ) || canOwnerClearCompany(uid)
        || canSelfClearOrphanCompany(uid);
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if isMember(companyId)
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if isOwnerOrAdmin(companyId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name == resource.data.name
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.rubro in ['ropa', 'calzado', 'ambos'];
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(companyId)
          || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.email == email()
          && (
            (
              request.resource.data.role == 'owner'
              && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerId == request.auth.uid
            )
            || (
              request.resource.data.role in ['employee', 'administrator']
              && request.resource.data.invitationId is string
              && pendingInviteForEmail(companyId, request.resource.data.invitationId)
              && get(invitationPath(companyId, request.resource.data.invitationId)).data.role == request.resource.data.role
            )
          );
        allow update: if false;
        allow delete: if isOwner(companyId)
          && resource.data.role in ['employee', 'administrator'];
      }

      match /invitations/{invitationId} {
        allow read: if isOwner(companyId)
          || (signedIn() && resource.data.email == email());
        allow create: if isOwner(companyId)
          && request.resource.data.role in ['employee', 'administrator']
          && request.resource.data.status == 'pending'
          && request.resource.data.email is string
          && request.resource.data.email.size() > 0
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.code is string
          && request.resource.data.code.size() == 6;
        allow update: if (
          isOwner(companyId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'revoked'
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
        ) || (
          signedIn()
          && resource.data.email == email()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
        );
        allow delete: if false;
      }

      match /products/{productId} {
        allow read: if isMember(companyId);
        allow create: if isMember(companyId) && hasSyncFields(productId);
        allow update: if isMember(companyId)
          && hasSyncFields(productId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            request.resource.data.deletedAt == resource.data.deletedAt
            || isOwnerOrAdmin(companyId)
          );
        allow delete: if false;
      }

      match /customers/{customerId} {
        allow read: if isMember(companyId);
        allow create: if isMember(companyId) && hasSyncFields(customerId);
        allow update: if isMember(companyId)
          && hasSyncFields(customerId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            request.resource.data.deletedAt == resource.data.deletedAt
            || isOwnerOrAdmin(companyId)
          );
        allow delete: if false;
      }

      match /orders/{orderId} {
        allow read: if isMember(companyId);
        allow create: if isMember(companyId) && hasSyncFields(orderId);
        allow update: if isMember(companyId)
          && hasSyncFields(orderId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            request.resource.data.deletedAt == resource.data.deletedAt
            || isOwnerOrAdmin(companyId)
          );
        allow delete: if false;
      }
    }

    match /{path=**}/invitations/{invitationId} {
      allow read: if signedIn() && resource.data.email == email();
    }
  }
}
